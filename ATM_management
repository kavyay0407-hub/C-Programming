#include <stdio.h>

void deposit(float *b)
{
    float x;
    scanf("%f",&x);
    if(x>0) *b+=x;
    else printf("Invalid amount\n");
}

void withdraw(float *b)
{
    float x;
    scanf("%f",&x);
    if(x>0 && x<=*b) *b-=x;
    else printf("Insufficient balance\n");
}

int main()
{
    int ch;
    float bal=5000,x;
    
    do
    {
        printf("\n1. Check Balance\n");
        printf("2. Deposit Money\n");
        printf("3. Withdraw Money\n");
        printf("4. Transfer Money\n");
        printf("5. Account Details\n");
        printf("6. Exit\n");
        printf("Enter choice: ");
        scanf("%d",&ch);

        switch(ch)
        {
            case 1: printf("Balance = %.2f\n",bal); break;
            case 2: printf("Enter amount: "); deposit(&bal); break;
            case 3: printf("Enter amount: "); withdraw(&bal); break;
            case 4:
                printf("Enter amount: ");
                scanf("%f",&x);
                if(x>0 && x<=bal) bal-=x;
                else printf("Insufficient balance\n");
                break;
            case 5: printf("Balance = %.2f\n",bal); break;
            case 6: printf("Thank you!\n"); break;
            default: printf("Invalid choice\n");
        }
    }while(ch!=6);

    return 0;
}